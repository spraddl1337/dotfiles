{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "auto",
      "source": "/usr/share/icons/garuda/dr460nized-start.png",
      "width": 14,
      "padding": {
            "top": 4,           // Top padding
            "left": 2,          // Left padding
            "right": 0          // Right padding
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "os",
            "key": " OS",
            "format": "{3} arch{12}",
            "keyColor": "yellow"
        },
        {
            "type": "de",
            "key": "├ DE",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "├ Kernel",
            //"format": "{1} {2}",
            "keyColor": "yellow"
        },
        {
            "type": "Locale",
            "key": "├ locale",
            "keyColor": "yellow"
        },
        {
            "type": "Keyboard",
            "key": "├ KeyBoard",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "├󰏖 Packages",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "├ Shell",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "├󰅐 UpTime",
            "keyColor": "yellow"
        },
        {"type": "command",
        "key": "├󰅐 OS-Age ",
        "keyColor": "yellow",
        "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
        },
/*        {"type": "command",
        "key": "├󰅐 OS-Birthday ",
        "keyColor": "yellow",
        "text": "birth_install=$(stat -c %W /); echo $(date -d @$birth_install '+%d %b %Y')"
        },
*/
        {
            "type": "datetime",
            "key": "└󰅐 Time",
            "keyColor": "yellow",
            "format": "{1}-{3}-{11} {14}:{17}"
        },
        "break",
        {
            "type": "chassis",
            "key": "󰌢 PC",
            "keyColor": "green"
        },
        {
            "type": "board",
            "key": "├ Board",
            "keyColor": "green"
        },
        {
            "type": "bios",
            "key": "├ BIOS",
            "keyColor": "green"
        },
        {
            "type": "bootmgr",
            "key": "├ BootMgr",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "├󰻠 CPU",
            "keyColor": "green",
            "temp": true,
            "freqNdigits": 1
        },
        {
            "type": "cpuusage",
            "key": "├󰻠 CPU use",
            "keyColor": "green",
            "temp": true,
            "percent": {
                "type": 3, // 3 = show number + bar + percentage
                "green": 30, // <30% is green
                "yellow": 70 // 30-70% is yellow, >70% is red
            },
            "freqNdigits": 1,
        },
        {
            "type": "memory",
            "key": "├ RAM ",
            "percent": {
                "type": 3, // 3 = show number + bar + percentage
                "green": 30, // <30% is green
                "yellow": 70 // 30-70% is yellow, >70% is red
            },
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": "├󰓡 Swap {2}",
            "separate": true,
            "percent": {
                "type": 3, // 3 = show number + bar + percentage
                "green": 30, // <30% is green
                "yellow": 70 // 30-70% is yellow, >70% is red
            },
            "keyColor": "green"
        },
        {
            "type": "physicaldisk",
            "key": "├ PhyDisk {2}",
            "temp": true,
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "├ Disk {1}",
            "percent": {
                "type": 3, // 3 = show number + bar + percentage
                "green": 30, // <30% is green
                "yellow": 70 // 30-70% is yellow, >70% is red
            },
            "keyColor": "green"
        },
        {
            "type": "monitor",
            "key": "├󰍹 Display(s)",
            //"format": "{1} {2}x{3}px {4}hz}",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "├󰍛 GPU",
            "format": "{1} {2} {3} [{6}]",
            "keyColor": "green"
        },
        {
            "type": "opengl",
            "key": "├󰍛 OpenGL",
            "format": "{1} {#1}{#32}GLSL:{#0} {4}",
            "keyColor": "green"
        },
        {
            "type": "vulkan",
            "key": "├󰍛 Vulkan",
            "keyColor": "green"
        },
    /*
        {
            "type": "sound",
            "key": "├ Sound",
            "keyColor": "green"
        },
        {
            "type": "gamepad",
            "key": "├ Gamepad",
            "keyColor": "green"
        },
        {
            "type": "mouse",
            "key": "├ Mouse",
            "keyColor": "green"
        },
        {
            "type": "camera",
            "key": "├ Camera",
            "keyColor": "green"
        },
    */
        {
            "type": "battery",
            "key": "└󱐥 Power",
            "temp": true,
            "keyColor": "green"
        },
        "break",
        {
            "type": "wifi",
            "key": " WLAN",
            "keyColor": "blue"
        },
/*        {
            "type": "netio",
            "key": "├󰩟 Net IO ({2})",
            "keyColor": "blue"
        },
*/
        {
            "type": "dns",
            "key": "├󰩟 DNS",
            "keyColor": "blue"
        },
        {
            "type": "localip",
            "key": "├󰩟 LocalIP ({2})",
            "showIpv6": false,
            "showFlags": true,
            "showMac": true,
            "showSpeed": true,
            "showAllIps": true,
            "format": " {1} ({3})",
            "keyColor": "blue"
        },
        {
            "type": "publicip",
            "key": "└󰩟 PublicIP  ",
            "showIpv6": false,
            "showMac": false,
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "├󰒄 TCP Ports",
            "keyColor": "blue",
            "text": "ss -tlnH | awk '{print $4}' | sed 's/.*://' | sort -nu | tr '\\n' ' ' | sed 's/ $//'"
        },
        {
            "type": "command",
            "key": "└󰒄 UDP Ports",
            "keyColor": "blue",
            "text": "ss -ulnH | awk '{print $4}' | sed 's/.*://' | sort -nu | tr '\\n' ' ' | sed 's/ $//'"
        },
        {
            "type": "bluetoothradio",
            "key": "󰂯 BT ",
            "keyColor": "blue",
        },
        {
            "type": "bluetooth",
            "key": "├󰂯 BT Devices",
            "format": "{1} {3} ({4})",
            "showDisconnected": false,
            "keyColor": "blue",
        },
    /*
        {
            "type": "lm",
            "key": "󰧨 Login Manager",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "├󰧨 Window Manager",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "├󰉼 WM Theme",
            "keyColor": "blue"
        },
        {
            "type": "theme",
            "key": "├ Color Themes",
            "keyColor": "blue"
        },
        {
            "type": "cursor",
            "key": "├󰇀 cursor Theme",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "├󰸉 System Icons",
            "keyColor": "blue"
        },
        {
            "type": "font",
            "key": "├ System Fonts",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "├ Terminal",
            "format": "{3} v.{4}",
            "keyColor": "blue"
        },
        {
            "type": "terminalsize",
            "key": "├ Terminal Size",
            "format": "{2} columns x {1} rows ({#37}{3}px x {4}px)",
            "keyColor": "blue"
        },
        {
            "type": "terminaltheme",
            "key": "└ Terminal Theme",
            //"format": "{3} v.{4}",
            "keyColor": "blue"
        },
    */
        "break",
        {
            "type": "custom",
            "format":"{#0}󰮯 {#0} • {#0}• {#0}• {#31} 󰊠 {#32} 󰊠 {#33} 󰊠 {#34} 󰊠 {#35} 󰊠 {#36} 󰊠"
            // "format":"{#37}󰮯 {#31} 󰧞 {#32} 󰧞 {#33} 󰧞 {#36} 󰊠 {#35} 󰊠 {#34} 󰊠 {#33} 󰊠 {#32} 󰊠 {#31} 󰊠 "
        },
        {
        "type": "version",
        "key": "",
        "format": "{1} {2} {#37}{6}",
        "keyColor": "cyan"
        },
    ]
}
