 
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/MEGA/Shell-src/ASCII-raspberryPi.txt",
    //"source": "ASCII-raspberryPi.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
    /*
    "type": "builtin",
    "width": 18,
    */
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "title",
      "key": "Hostname",
      "keyColor": "green",
      "format": "{user-name-colored}@\u001b[0;31m{host-name}  \u001b[38;5;240m{user-shell}",
      "keyWidth": 12
    },
    {
      "type": "host",
      "key": "Modell",
      "keyColor": "green",
      "keyWidth": 12
    },
    {
      "type": "command",
      "key": "Groups",
      "keyWidth": 12,
      "keyColor": "green",
      "text": "groups"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyWidth": 12,
      "keyColor": "green",
      "format": "{name} {temperature} {freq-base} \u001b[38;5;240m core:{cores-physical} mArch:{march}",
      "temp": true,
      "percent": {
          "type": 3, // 3 = show number + bar + percentage
          "green": 30, // <30% is green
          "yellow": 70 // 30-70% is yellow, >70% is red
      },
      "freqNdigits": 1,
    },
    {
      "type": "cpuusage",
      "key": "CPU use",
      "keyWidth": 12,
      "keyColor": "green",
      "format": "{avg-bar} {avg}",
      "temp": true,
      "percent": {
          "type": 3, // 3 = show number + bar + percentage
          "green": 30, // <30% is green
          "yellow": 70 // 30-70% is yellow, >70% is red
      },
      "freqNdigits": 1,
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyWidth": 12,
      "keyColor": "green",
      "format": "{4} {percentage} | {used}/{total}",
      "percent": {
          "type": 3, // 3 = show number + bar + percentage
          "green": 30, // <30% is green
          "yellow": 70 // 30-70% is yellow, >70% is red
      },
      "freqNdigits": 1,
    },
    {
      "type": "disk",
      "key": "Disk {1}",
      "keyWidth": 12,
      "keyColor": "green",
      "format": "{size-percentage-bar} {size-percentage} | {size-used}/{size-total} [Free:{size-free}] {filesystem}",
      "percent": {
                "type": 3, // 3 = show number + bar + percentage
                "green": 30, // <30% is green
                "yellow": 70 // 30-70% is yellow, >70% is red
            }
    },
    {
      "type": "command",
      "key": "IP LAN",
      "keyWidth": 12,
      "keyColor": "cyan",
      "text": "hostname -I | awk '{print $1}'"
    },
    {
      "type": "command",
      "key": "MAC LAN",
      "keyWidth": 12,
      "keyColor": "cyan",
      "text": "cat /sys/class/net/eth0/address"
    },
    {
      "type": "wifi",
      "key": "WLAN",
      "keyWidth": 12,
      "keyColor": "blue",
      "format": "{ssid} {band}GHz [{signal-quality}|{status}]\u001b[38;5;240m {security} {protocol}"
    },
    {
      "type": "command",
      "key": "IP WLAN",
      "keyWidth": 12,
      "keyColor": "blue",
      "text": "hostname -I | awk '{print $2}'"
    },
    {
      "type": "command",
      "key": "MAC WLAN",
      "keyWidth": 12,
      "keyColor": "blue",
      "text": "cat /sys/class/net/wlan0/address"
    },
    {
      "type": "command",
      "key": "Ports TCP",
      "keyWidth": 12,
      "keyColor": "magenta",
       "text": "ports=$(ss -tlnH | awk '{split($4,a,\":\"); print a[length(a)]}' | sort -nu | xargs); printf '\\033[0;35m%s\\033[0;35m' \"$ports\""
    },
    {
      "type": "command",
      "key": "Ports UDP",
      "keyWidth": 12,
      "keyColor": "yellow",
      "text": "ports=$(ss -ulnH | awk '{print $4}' | sed 's/.*://' | sort -nu | tr '\\n' ' '); printf '\\033[1;33m%s\\033[0m' \"$ports\""
    },
    {
    "type": "command",
    "key": "Updates",
    "keyWidth": 12,
    "text": "if [ -f ~/updates.txt ]; then . ~/updates.txt; else total_updates=0; security_updates=0; last_checked='N/A'; fi; echo \"Total:\\033[1;36m $total_updates \\033[0m| Security:\\033[0;31m $security_updates \\033[0m| Last check: $last_checked\""
    },
    {
    "type": "uptime",
    "key": "UpTime",
    "keyWidth": 12
    }
  ]
}
