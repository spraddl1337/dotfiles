// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "position": "top",
        "padding" : {
            "left": 4,
            }
    },
    "display": {
        "separator": " ❀ ",
        "key": {
            "width": 22, //21
            "paddingLeft": 4, //2
        },
        "size": {
          "binaryPrefix": "jedec",
        },
        "percent": {
            "type": 11
        },
        "bar": {
            "border": {
                "left": "\uee00",
                "leftElapsed": "\uee03",
                "right": "\uee02",
                "rightElapsed": "\uee05"
            },
            "char": {
                "total": "\uee01",
                "elapsed": "\uee04"
            },
            "width": 49
        },
    },
    "modules": [
        {
            "type": "custom",
            "format": "  ┏━━━━━━━━━━━━━━━━━━━━ {#32}System Info{#0} ━━━━━━━━━━━━━━━━━━━━┓"
        },
        "break",
        {
            "key": "  User      ",
            "type": "title",
            "format": "{user-name}",
            "keyColor": "31"
        },
        {
            "key": " 󰅐 Uptime    ",
            "type": "uptime",
            "keyColor": "31"
        },
        {"type": "command",
            "key": " 󰅐 OS-Age    ",
            "keyColor": "31",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
        },
        {
            "key": "  OS        ",
            "type": "os",
            "format": "{name} {version}",
            "keyColor": "32"
        },
        {
            "key": "  Kernel    ",
            "type": "kernel",
            "format": "{release} {sysname}",
            "keyColor": "32"
        },
        {
            "key": " 󰻠 Arch      ",
            "type": "os",
            "format": "{name} {variant} - {arch}",
            "keyColor": "32"
        },
        {
            "key": "  Terminal  ",
            "type": "terminal",
            "keyColor": "33"
        },
        {
            "key": "  Shell     ",
            "type": "shell",
            "keyColor": "33"
        },
//        "break",
//        {
//             "type": "custom",
//             "format": "   -----------------------------------------------"
//        },
//        "break",
        {
            "type": "host",
            "key": "  Device    ",
            "keyColor": "34"
        },
        {
            "type": "cpu",
            "key": "  CPU       ",
            "format": "{vendor} {name} ({cores-logical}) @ {freq-max}",
            "keyColor": "34",
            "temp": true,
            "freqNdigits": 1
        },
        {
            "type": "gpu",
            "key": " 󰍛 GPU       ",
            "format": "{1} {2} {3}",
            "keyColor": "34"
        },
        {
            "key": "  RAM       ",
            "type": "memory",
            "keyColor": "34",
            "format": "{used} / {total} ({percentage})",
            "percent": {
                "type": 3, // 3 = show number + bar + percentage
                "green": 30, // <30% is green
                "yellow": 70 // 30-70% is yellow, >70% is red
            }
        },
//        {
//             "type": "custom",
//             "format": "   -----------------------------------------------"
//        },
//        "break",
        {
            "type": "dns",
            "key": " 󰇖 DNS       ",
            "keyColor": "blue"
        },
        {
            "type": "localip",
            "key": " 󰩟 LocalIP ({2})",
            "showIpv6": false,
            "showFlags": true,
            "showMac": true,
            "showSpeed": true,
            "showAllIps": false,
            "format": " {1} ({3})",
            "keyColor": "blue"
        },
        {
            "type": "publicip",
            "key": " 󰩟 PublicIP  ",
            "showIpv6": false,
            "showMac": false,
            "keyColor": "blue"
        },
        {
            "type": "bluetoothradio",
            "key": " 󰂯 BT        ",
            "keyColor": "blue",
        },
        {
            "type": "bluetooth",
            "key": " 󰂯 BT Devices",
            "format": "{1} {3} ({4})",
            "showDisconnected": false,
            "keyColor": "blue",
        },
        "break",
        {
             "type": "custom",
             "format": "   -----------------------------------------------------"
        },
        "break",
        {
            "key": " 󰋊 Storage   ",
            "type": "disk",
            "keyColor": "35",
            "folders": "/storage/emulated",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "key": "  ",
            "separator": " ",
            "type": "disk",
            "keyColor": "35",
            "folders": "/storage/emulated",
            "format": "{size-percentage-bar}"
        },
        "break",
        {
            "key": "  SD Card   ",
            "type": "disk",
            "keyColor": "35",
            // "folders": "/storage/FD9B-F986/",
            "folders": "/mnt/media_rw/FD9B-F986", // If doesn't change the dir, add "{mountpoint}" in "format": down bellow to know your external storage path.
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "key": "  ",
            "type": "disk",
            "keyColor": "35",
            "folders": "/mnt/media_rw/FD9B-F986",
            "format": "{size-percentage-bar}"
        },
        "break",
        { 
             "type": "custom", 
             "format": "  ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
        },
        "break",
//        {
//            "type": "title",
//            "format": "   -----------------------------------------------------\u001b[31D Welcome "
//        },
        {
            "type": "title",
            "format": "  \u001b[37D {#yellow}{user-name}{#}@{#blue}{host-name}{#} {#0}󰮯{#0} • {#0}• {#31}󰊠 {#32} 󰊠 {#33} 󰊠 {#34} 󰊠 {#35} 󰊠 {#36} 󰊠 "
        },
        "break",
    ]
}

