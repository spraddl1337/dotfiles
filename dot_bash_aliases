# ------------------------------------------------------------------
# Common
# ------------------------------------------------------------------
alias python="$(which python3)"
alias pip=pip3

# ------------------------------------------------------------------
# Navigation
# ------------------------------------------------------------------
alias cd..="cd .."
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd $HOME" # `cd` is probably faster to type though
alias -- -="cd -"

# ------------------------------------------------------------------
# Copy / Get / Remove
# ------------------------------------------------------------------
# mv, cp confirmation
alias mkdir="mkdir -pv"
alias cp="cp -iv"
alias ln='ln -i'
alias mv="mv -iv"

#better cat: batcat -> bcat
alias bcat='batcat'
alias bat='batcat'

#see all hidden files within a directory listed in color mode.
#alias ls+='ls -d .* --color=auto'
#exa=better-ls
alias ls='eza --icons --color=always'
alias ls+='eza --long --group-directories-first --icons -h'
alias ,,='eza --icons --color=always'

#dir now display directories first , show all files with different colors,
#shows all files and display permissions, file sizes and date as well.
#alias dir+='dir -achltr --group-directories-first --color=auto'
alias dir+='eza -T -L 2 --long --group-directories-first --icons'

#Check open ports
#checks open ports on your computer but not all services,
#you have to run it as root (sudo) in order to display all !
alias ports='netstat -tulanp'


